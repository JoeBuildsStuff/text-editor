# Better Auth requires a secret for hashing + encryption.
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string

# Base URL for the Better Auth instance (also exposed to the client so auth links work).
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Paths for the local SQLite databases (override if you store them elsewhere).
AUTH_SQLITE_PATH=./server/auth.sqlite
DOCUMENTS_SQLITE_PATH=./server/documents.db

# Python sandbox controls (optional locally, enabled in production)
ENABLE_PYTHON_SANDBOX=false
PYTHON_DOCKER_IMAGE=python:3.11-slim

# Allow network access in sandbox (required for pip install)
ALLOW_SANDBOX_NETWORK=true

# Execution timeout in milliseconds (default: 120000 = 2 minutes)
# PYTHON_EXEC_TIMEOUT_MS=120000

# Sandbox directory path (default: ./server/python-sandbox)
# PYTHON_SANDBOX_DIR=./server/python-sandbox

# Sandbox cleanup settings (for the cleanup script)
# SANDBOX_TTL_HOURS=24        # Delete sandboxes idle for more than this
# SANDBOX_MAX_SIZE_MB=500     # Delete sandboxes larger than this

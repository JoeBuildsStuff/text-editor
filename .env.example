# Better Auth Configuration (Required)
# Generate a secret key (min 32 characters):
# openssl rand -base64 32
BETTER_AUTH_SECRET=your-generated-secret-key-here-min-32-characters-long
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Optional - Required for Google sign-in)
# Get these from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/
# 2. Create/select a project and enable Google+ API
# 3. Create OAuth 2.0 credentials (Web application)
# 4. Add authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Database Paths (Optional - defaults to server/ directory)
# AUTH_SQLITE_PATH=./server/auth.sqlite
# DOCUMENTS_SQLITE_PATH=./server/documents.db

# File Storage (Optional - defaults to server/uploads/)
# FILE_STORAGE_DIR=./server/uploads

# Python Sandbox Configuration (Optional)
# ENABLE_PYTHON_SANDBOX=true
# PYTHON_SANDBOX_DIR=./server/python-sandbox
# PYTHON_DOCKER_IMAGE=python:3.11-slim
# NODE_DOCKER_IMAGE=node:22-slim
# PYTHON_EXEC_TIMEOUT_MS=120000
# ALLOW_SANDBOX_NETWORK=true

# AI Chat (Optional - required for assistant responses)
# ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key
# CEREBRAS_API_KEY=your-cerebras-api-key
# Optional override: claude-haiku-4-5 | claude-sonnet-4-6 | claude-opus-4-6 | gpt-oss-120b | gpt-5.4 | gpt-5 | gpt-5.4-mini | gpt-5.4-nano
# OPENAI_CHAT_MODEL=gpt-5.4-mini
